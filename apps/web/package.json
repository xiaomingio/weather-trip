{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host ${WEB_HOST:-127.0.0.1} --port ${WEB_PORT:-3000}",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
