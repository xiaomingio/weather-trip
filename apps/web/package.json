    "@astrojs/react": "^6.0.1",
    "@radix-ui/react-slider": "^1.4.4",
    "astro": "^7.1.2",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "weather-core": "*",
    "weather-db": "*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
