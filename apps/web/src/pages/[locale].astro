---
/**
 * 文件说明: 渲染中英文 Landing 全屏 Hero 首页，含天气图切换、城市示例与工具 Tab 入口。
 * 对应文档: docs/specs/10-product-design.md
 */
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import Analytics from '@/components/Analytics.astro';
import SiteNav from '@/components/SiteNav.astro';
import SitePreferences from '@/components/SitePreferences.astro';
import type { DisplayLocale } from '@/domain/format';
import { buildTopTabPath } from '@/domain/navigation';
import { buildAbsoluteUrl, getAlternateLinks, getPublicPage, ogImagePath } from '@/domain/seo';
import '@/styles/global.css';
import '@/styles/landing.css';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }];
}

type Props = {
  locale?: DisplayLocale;
};

type LandingStats = {
  countryCount: number;
  cityCount: number;
  forecastDayCount: number;
};

const fallbackStats: LandingStats = {
  countryCount: 200,
  cityCount: 3500,
  forecastDayCount: 14
};

async function readLandingStats(): Promise<LandingStats> {
  try {
    const report = JSON.parse(
      await readFile(path.resolve(process.cwd(), '..', '..', 'data', 'generated', 'city-selection-report.json'), 'utf8')
    ) as { cityCount: number; byCountry: unknown[] };
    return {
      countryCount: report.byCountry.length,
      cityCount: report.cityCount,
      forecastDayCount: 14
    };
  } catch (error) {
    console.warn(
      `Landing stats fell back to static coverage labels: ${error instanceof Error ? error.message : String(error)}`
    );
    return fallbackStats;
  }
}

const requestedLocale = Astro.props.locale ?? Astro.params.locale;
if (!Astro.props.locale && requestedLocale !== 'zh') {
  return new Response('Not found', { status: 404 });
}

const locale: DisplayLocale = requestedLocale === 'zh' ? 'zh' : 'en';
const otherLocale: DisplayLocale = locale === 'zh' ? 'en' : 'zh';

const { countryCount, cityCount, forecastDayCount } = await readLandingStats();

const citiesLabel = cityCount >= 3500 ? '3500+' : String(cityCount);
const regionsLabel = countryCount >= 200 ? '200+' : String(countryCount);

type SampleWeather = 'sun' | 'cloud' | 'drizzle' | 'snow';

type CitySample = {
  id: string;
  tempC: number;
  weather: SampleWeather;
  humidity: number;
  elevationM: number;
  names: Record<DisplayLocale, string>;
  weatherLabels: Record<DisplayLocale, string>;
};

const citySamples: CitySample[] = [
  {
    id: 'shanghai',
    tempC: 19,
    weather: 'cloud',
    humidity: 68,
    elevationM: 4,
    names: { zh: '上海', en: 'Shanghai' },
    weatherLabels: { zh: '多云', en: 'Cloudy' }
  },
  {
    id: 'nyc',
    tempC: 21,
    weather: 'sun',
    humidity: 52,
    elevationM: 10,
    names: { zh: '纽约', en: 'New York' },
    weatherLabels: { zh: '晴天', en: 'Sunny' }
  },
  {
    id: 'hokkaido',
    tempC: -6,
    weather: 'snow',
    humidity: 74,
    elevationM: 40,
    names: { zh: '北海道', en: 'Hokkaido' },
    weatherLabels: { zh: '小雪', en: 'Light snow' }
  },
  {
    id: 'paris',
    tempC: 12,
    weather: 'drizzle',
    humidity: 81,
    elevationM: 35,
    names: { zh: '巴黎', en: 'Paris' },
    weatherLabels: { zh: '小雨', en: 'Light rain' }
  },
  {
    id: 'rio',
    tempC: 31,
    weather: 'sun',
    humidity: 82,
    elevationM: 11,
    names: { zh: '里约热内卢', en: 'Rio de Janeiro' },
    weatherLabels: { zh: '晴天', en: 'Sunny' }
  },
  {
    id: 'sydney',
    tempC: 24,
    weather: 'sun',
    humidity: 55,
    elevationM: 19,
    names: { zh: '悉尼', en: 'Sydney' },
    weatherLabels: { zh: '晴天', en: 'Sunny' }
  },
  {
    id: 'lhasa',
    tempC: 12,
    weather: 'sun',
    humidity: 32,
    elevationM: 3650,
    names: { zh: '拉萨', en: 'Lhasa' },
    weatherLabels: { zh: '晴天', en: 'Sunny' }
  },
  {
    id: 'cairo',
    tempC: 36,
    weather: 'sun',
    humidity: 28,
    elevationM: 74,
    names: { zh: '开罗', en: 'Cairo' },
    weatherLabels: { zh: '晴天', en: 'Sunny' }
  }
];

const weatherIconId: Record<SampleWeather, string> = {
  sun: 'icon-sun',
  cloud: 'icon-cloud',
  drizzle: 'icon-drizzle',
  snow: 'icon-snow'
};

const copy = {
  zh: {
    title: '天气旅行 | 用天气决定下一个城市',
    description: '查看全球城市未来天气，或先选择你想要的天气，再去找刚好适合抵达的地方。',
    brandZh: '天气旅行',
    heroTitle: '让天气替你挑一座城市',
    heroTitleLines: ['让天气替你', '挑一座城市'],
    heroLead:
      '出发前先看全球城市接下来几天的温度、晴雨和湿度；也可以先选择你想要的天气，再去找刚好适合抵达的地方。',
    primaryAction: '查看全球天气',
    secondaryAction: '寻找匹配城市',
    unitToggle: '切换摄氏度与华氏度',
    languageToggle: 'Switch to English',
    coverageLabel: '数据覆盖',
    cities: '城市',
    regions: '国家和地区',
    days: (n: number) => `未来 ${n} 天预报`,
    citySamples: '城市天气示例',
    artAlt: '旅行天气地图、透明气候图层和指南针组成的画册式预览',
    figBrand: '天气旅行',
    figLayers: '天气 · 温度 · 湿度 · 海拔',
    humidity: (v: number) => `湿度 ${v}%`,
    elevation: (v: number) => `海拔 ${v}m`
  },
  en: {
    title: 'Weather Trip | Choose your next city by weather',
    description:
      'Scan future weather across global cities, or first choose the weather you want, then find the right place to land.',
    brandZh: 'Weather Trip',
    heroTitle: 'Let weather pick your next city',
    heroTitleLines: ['Let weather pick', 'your next city'],
    heroLead:
      'Before you go, scan temperature, sky, and humidity for cities worldwide—or first choose the weather you want, then find the right place to land.',
    primaryAction: 'View world weather',
    secondaryAction: 'Find matching cities',
    unitToggle: 'Switch Celsius / Fahrenheit',
    languageToggle: '切换到中文',
    coverageLabel: 'Coverage',
    cities: 'cities',
    regions: 'countries & regions',
    days: (n: number) => `${n}-day forecast`,
    citySamples: 'City weather samples',
    artAlt: 'Travel weather map preview with climate layers and compass',
    figBrand: 'Weather Trip',
    figLayers: 'Weather · Temperature · Humidity · Elevation',
    humidity: (v: number) => `Humidity ${v}%`,
    elevation: (v: number) => `Elevation ${v}m`
  }
}[locale];

const weatherPath = buildTopTabPath(locale, 'weather-map');
const comparePath = buildTopTabPath(locale, 'city-finder');
const otherLandingPath = buildTopTabPath(otherLocale, 'landing');
const seoPage = getPublicPage(locale, 'landing');
const alternateLinks = getAlternateLinks('landing');
const sunnyAtlas = {
  webp: '/landing/climate-atlas-sunny.webp'
};
const rainAtlas = {
  webp: '/landing/climate-atlas-rain.webp'
};
const snowAtlas = {
  webp: '/landing/climate-atlas-snow.webp'
};
---

<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-weather-theme="sunny">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <link rel="canonical" href={buildAbsoluteUrl(seoPage.path)} />
    <link rel="alternate" hreflang="en" href={alternateLinks.en} />
    <link rel="alternate" hreflang="zh-Hans" href={alternateLinks['zh-Hans']} />
    <link rel="alternate" hreflang="x-default" href={alternateLinks['x-default']} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href={sunnyAtlas.webp} type="image/webp" fetchpriority="high" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Weather Trip" />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:url" content={buildAbsoluteUrl(seoPage.path)} />
    <meta property="og:image" content={buildAbsoluteUrl(ogImagePath)} />
    <meta name="twitter:card" content="summary_large_image" />
    <Analytics />
  </head>
  <body class="landing-page">
    <main class="page">
      <SiteNav
        locale={locale}
        activeTab="landing"
        unitLabel="°C"
        unitToggleLabel={copy.unitToggle}
        localeHref={otherLandingPath}
        localeLabel={copy.languageToggle}
        navLabel={copy.brandZh}
      />

      <section class="hero" aria-label={copy.brandZh}>
        <canvas class="climate-canvas" data-climate-canvas aria-hidden="true"></canvas>
        <div class="hero-copy">
          <p class="kicker">{copy.brandZh}</p>
          <h1 class={`hero-title hero-title-${locale}`} aria-label={copy.heroTitle}>
            {copy.heroTitleLines.map((line, index) => (
              <span>{line}{locale === 'en' && index < copy.heroTitleLines.length - 1 ? ' ' : ''}</span>
            ))}
          </h1>
          <p class="lede">{copy.heroLead}</p>
          <div class="actions">
            <a class="primary-link" href={weatherPath}><span class="action-label">{copy.primaryAction}</span></a>
            <a class="secondary-link" href={comparePath}><span class="action-label">{copy.secondaryAction}</span></a>
          </div>
          <ul class="coverage" aria-label={copy.coverageLabel}>
            <li>{citiesLabel} {copy.cities}</li>
            <li>{regionsLabel} {copy.regions}</li>
            <li>{copy.days(forecastDayCount)}</li>
          </ul>

          <svg class="icon-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <symbol
              id="icon-sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </symbol>
            <symbol
              id="icon-cloud"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
            </symbol>
            <symbol
              id="icon-drizzle"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
              <path d="M8 19v1"></path>
              <path d="M8 14v1"></path>
              <path d="M16 19v1"></path>
              <path d="M16 14v1"></path>
              <path d="M12 21v1"></path>
              <path d="M12 16v1"></path>
            </symbol>
            <symbol
              id="icon-snow"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
              <path d="M8 15h.01"></path>
              <path d="M8 19h.01"></path>
              <path d="M12 17h.01"></path>
              <path d="M12 21h.01"></path>
              <path d="M16 15h.01"></path>
              <path d="M16 19h.01"></path>
            </symbol>
          </svg>

          <ul class="city-samples" aria-label={copy.citySamples}>
            {
              citySamples.map((sample) => {
                const name = sample.names[locale];
                const weatherLabel = sample.weatherLabels[locale];
                const aria = `${name} ${sample.tempC}° ${weatherLabel} ${copy.humidity(sample.humidity)} ${copy.elevation(sample.elevationM)}`;
                return (
                  <li class={`city-card city-${sample.id}`} data-temp-c={sample.tempC} aria-label={aria}>
                    <div class="city-head">
                      <strong data-temp-display>
                        <span class="temp-num">{sample.tempC}</span>
                        <span class="temp-unit">°C</span>
                      </strong>
                      <b>{name}</b>
                    </div>
                    <div class="city-meta">
                      <span class="meta" title={weatherLabel}>
                        <svg class="meta-icon" aria-hidden="true">
                          <use href={`#${weatherIconId[sample.weather]}`}></use>
                        </svg>
                      </span>
                      <span class="meta" title={copy.humidity(sample.humidity)}>
                        <em>{sample.humidity}%</em>
                      </span>
                      <span class="meta" title={copy.elevation(sample.elevationM)}>
                        <em>{sample.elevationM}m</em>
                      </span>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <figure class="hero-art" data-weather-atlas>
          <div class="weather-stack">
            <picture class="weather-layer weather-layer-base">
              <img
                src={sunnyAtlas.webp}
                width="1248"
                height="832"
                alt={copy.artAlt}
                decoding="async"
                fetchpriority="high"
              />
            </picture>
            <picture class="weather-layer weather-layer-rain" data-weather-layer="rain">
              <img
                data-src={rainAtlas.webp}
                width="1248"
                height="832"
                alt=""
                aria-hidden="true"
                decoding="async"
                loading="lazy"
              />
            </picture>
            <picture class="weather-layer weather-layer-snow" data-weather-layer="snow">
              <img
                data-src={snowAtlas.webp}
                width="1248"
                height="832"
                alt=""
                aria-hidden="true"
                decoding="async"
                loading="lazy"
              />
            </picture>
          </div>
          <figcaption>
            <span>{copy.figBrand}</span>
            <strong>{copy.figLayers}</strong>
          </figcaption>
        </figure>
      </section>
    </main>

    <SitePreferences />
    <script is:inline src="/landing/climate-canvas.js"></script>
    <script is:inline src="/landing/weather-atlas.js"></script>
    <script is:inline src="/landing/nav-prefs.js"></script>
  </body>
</html>
