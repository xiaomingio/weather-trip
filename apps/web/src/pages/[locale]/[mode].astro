---
/**
 * 文件说明: 按中英文 locale 和查看模式路径从 Postgres 读取天气快照并渲染 React 工具页。
 * 对应文档: docs/data-flow.md
 */
import { createWeatherDatabase, readWeatherSnapshot } from 'weather-db';
import { WeatherDashboard } from '@/components/weather-dashboard';
import '@/styles/global.css';

const locale = Astro.params.locale === 'en' ? 'en' : 'zh';
const initialMode = Astro.params.mode === 'daily' ? 'daily' : 'travel';

if (Astro.params.mode !== 'travel' && Astro.params.mode !== 'daily') {
  return Astro.redirect(`/${locale}/travel`);
}

const db = createWeatherDatabase();
let snapshot;

try {
  snapshot = await readWeatherSnapshot(db);
} finally {
  await db.close();
}

const title = locale === 'zh' ? 'Global Weather Atlas | 按天气选择下一站' : 'Global Weather Atlas | Pick a destination by weather';
const description =
  locale === 'zh'
    ? '按天气、温度、降水、湿度和海拔筛选全球旅行目的地。'
    : 'Find travel destinations by weather, temperature, rainfall, humidity, and elevation.';
---

<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <WeatherDashboard
      client:load
      locale={locale}
      initialMode={initialMode}
      cities={snapshot.cities}
      forecasts={snapshot.forecasts}
      availableDates={snapshot.availableDates}
    />
  </body>
</html>
