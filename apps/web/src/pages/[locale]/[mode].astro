---
/**
 * 文件说明: 按中英文 locale 和工具 Tab 路径渲染天气工具页客户端壳。
 * 对应文档: docs/data-flow.md
 */
import SitePreferences from '@/components/site-preferences.astro';
import { WeatherDashboard } from '@/components/weather-dashboard';
import { getToolPathSegment, resolveToolMode } from '@/domain/navigation';
import { buildAbsoluteUrl, getAlternateLinks, getPublicPage, ogImagePath } from '@/domain/seo';
import '@/styles/global.css';

const requestedLocale = Astro.props.locale ?? Astro.params.locale;
const requestedMode = Astro.props.mode ?? Astro.params.mode;

if (!Astro.props.locale && requestedLocale !== 'zh') {
  return new Response('Not found', { status: 404 });
}

const locale = requestedLocale === 'zh' ? 'zh' : 'en';
const initialMode = resolveToolMode(requestedMode);

if (!initialMode) return new Response('Not found', { status: 404 });

const title =
  locale === 'zh'
    ? `Weather Trip | ${initialMode === 'daily' ? '全球天气地图' : '按天气找城市'}`
    : `Weather Trip | ${initialMode === 'daily' ? 'World Weather' : 'Weather Match'}`;
const description =
  locale === 'zh'
    ? initialMode === 'daily'
      ? '按日期查看全球城市气温、降水、湿度、天气类型和舒适度。'
      : '按温度、晴雨、湿度、海拔和出行天数反向寻找匹配城市。'
    : initialMode === 'daily'
      ? 'View temperature, rainfall, RH, weather type, and comfort across global cities by date.'
      : 'Find matching cities by temperature, sky, RH, elevation, and trip length.';
const tabId = getToolPathSegment(initialMode);
const seoPage = getPublicPage(locale, tabId);
const alternateLinks = getAlternateLinks(tabId);
---

<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-weather-theme="sunny">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={buildAbsoluteUrl(seoPage.path)} />
    <link rel="alternate" hreflang="en" href={alternateLinks.en} />
    <link rel="alternate" hreflang="zh-Hans" href={alternateLinks['zh-Hans']} />
    <link rel="alternate" hreflang="x-default" href={alternateLinks['x-default']} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Weather Trip" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={buildAbsoluteUrl(seoPage.path)} />
    <meta property="og:image" content={buildAbsoluteUrl(ogImagePath)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="weather-page">
    <WeatherDashboard
      client:load
      locale={locale}
      initialMode={initialMode}
      initialSearch={Astro.url.search}
    />
    <SitePreferences />
  </body>
</html>
