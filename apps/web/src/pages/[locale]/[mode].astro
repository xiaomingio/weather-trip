---
/**
 * 文件说明: 按中英文 locale 和工具 Tab 路径从 Postgres 读取天气快照并渲染 React 工具页。
 * 对应文档: docs/data-flow.md
 */
import { createWeatherDatabase, readWeatherSnapshot } from 'weather-db';
import { WeatherDashboard } from '@/components/weather-dashboard';
import { resolveToolMode } from '@/domain/navigation';
import '@/styles/global.css';

const requestedLocale = Astro.props.locale ?? Astro.params.locale;
const requestedMode = Astro.props.mode ?? Astro.params.mode;

if (!Astro.props.locale && requestedLocale !== 'zh') {
  return Astro.redirect('/');
}

const locale = requestedLocale === 'zh' ? 'zh' : 'en';
const initialMode = resolveToolMode(requestedMode);

if (!initialMode) {
  return Astro.redirect(locale === 'zh' ? '/zh' : '/');
}

const db = createWeatherDatabase();
let snapshot;

try {
  snapshot = await readWeatherSnapshot(db);
} finally {
  await db.close();
}

const title =
  locale === 'zh'
    ? `Weather Trip | ${initialMode === 'daily' ? '全球天气地图' : '按天气找城市'}`
    : `Weather Trip | ${initialMode === 'daily' ? 'World Weather' : 'Weather Match'}`;
const description =
  locale === 'zh'
    ? initialMode === 'daily'
      ? '按日期查看全球城市气温、降水、湿度、天气类型和舒适度。'
      : '按温度、晴雨、湿度、海拔和出行天数反向寻找匹配城市。'
    : initialMode === 'daily'
      ? 'View temperature, rainfall, RH, weather type, and comfort across global cities by date.'
      : 'Find matching cities by temperature, sky, RH, elevation, and trip length.';
---

<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-weather-theme="sunny">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="weather-page">
    <WeatherDashboard
      client:load
      locale={locale}
      initialMode={initialMode}
      initialSearch={Astro.url.search}
      cities={snapshot.cities}
      forecasts={snapshot.forecasts}
      availableDates={snapshot.availableDates}
    />
  </body>
</html>
