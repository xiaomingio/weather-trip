{
  "name": "weather-trip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "dev:web": "npm run dev --workspace web",
    "start:web": "npm run start --workspace web",
    "typecheck": "npm run build --workspace weather-core && npm run typecheck --workspace web",
    "arch:check": "depcruise --config .dependency-cruiser.cjs apps/*/src packages/*/src",
    "test": "npm --workspaces --include-workspace-root=false --if-present run test",
    "check": "npm run typecheck && npm run arch:check && npm test",
    "static:tourism:raw": "tsx scripts/generate-tourism-raw.ts",
    "static:tourism": "tsx scripts/generate-tourism-destinations.ts",
    "static:country-tier-candidates": "tsx scripts/generate-country-tier-candidates.ts",
    "static:profiles": "tsx scripts/generate-country-profiles.ts",
    "static:cities": "tsx scripts/generate-static-cities.ts",
    "static:geo": "tsx scripts/generate-static-geo.ts",
    "static:geo:tiles": "tsx scripts/generate-static-geo-tiles.ts",
    "weather:refresh": "tsx scripts/generate-static-weather.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "dependency-cruiser": "^17.3.1",
    "playwright": "^1.61.1",
    "shpjs": "^6.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
